{
  "name": "Coursera Skip Video & Reading",
  "description": "Streamline Coursera videos, readings, discussions, and course progress with a fast, safe, open-source productivity extension.",
  "version": "1.6.0",
  "manifest_version": 3,
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://www.coursera.org/*"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ]
}
